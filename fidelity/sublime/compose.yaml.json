"text": "# Services for the feed tools, generated for the fidelity harness.\nversion: \"3.9\"\n\nx-defaults: &defaults\n  restart: unless-stopped\n  logging:\n    driver: json-file\n    options:\n      max-size: 10m\n\nservices:\n  feed:\n    <<: *defaults\n    image: example/feed-tools:1.4.2\n    command: [\"node\", \"dist/feed.js\", \"--port\", \"8080\"]\n    ports:\n      - \"8080:8080\"\n      - 9229:9229\n    environment:\n      NODE_ENV: production\n      FEED_URL: https://example.com/podcast/feed.xml\n      RETRIES: 3\n      DEBUG: false\n      TIMEOUT: 2.5\n      PROXY: ~\n    healthcheck:\n      test: curl -f http://localhost:8080/health || exit 1\n      interval: 30s\n  worker:\n    <<: *defaults\n    image: 'example/feed-worker:latest'\n    depends_on: [feed]\n    volumes:\n      - ./data:/data:ro\n    labels:\n      description: >\n        Fetches new episodes every hour\n        and writes them to the cache.\n      notes: |\n        Keep the cache under 2 GB.\n        Started: 2026-10-01\n",
