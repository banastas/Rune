"text": "# Project settings, generated for the fidelity harness.\n[project]\nname = \"feed-tools\"\nversion = \"1.4.2\"\ndescription = 'Fetch, filter and publish podcast feeds'\nrequires-python = \">=3.11\"\nauthors = [{ name = \"Sam Example\", email = \"sam@example.com\" }]\nkeywords = [\"podcast\", \"rss\", \"feeds\"]\ndependencies = [\n    \"httpx>=0.27\",\n    \"lxml>=5.2\",\n]\n\n[project.scripts]\nfeed = \"feed_tools.cli:main\"\n\n[tool.ruff]\nline-length = 100\ntarget-version = \"py311\"\nexclude = [\".venv\", \"build\"]\n\n[tool.ruff.lint]\nselect = [\"E\", \"F\", \"I\"]\nignore = []\n\n[tool.feed]\nretries = 3\ntimeout = 2.5\nverbose = false\nmax_size = 1_048_576\nmask = 0o755\ncolor = 0xEC475D\nstarted = 2026-10-01T08:00:00Z\nwindow = { start = 08:00:00, end = 22:30:00 }\nbanner = \"\"\"\nNight Shift Notes\n  feed tools\"\"\"\npath = 'C:\\Users\\sam\\feeds'\n\n[[tool.feed.sources]]\nurl = \"https://example.com/podcast/feed.xml\"\nweight = 1.0\n\n[[tool.feed.sources]]\nurl = \"https://example.org/other.xml\"\nweight = -0.5\n",
