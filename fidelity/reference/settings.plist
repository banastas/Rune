<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.backup-notes</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/backup-notes</string>
		<string>--quiet</string>
		<string>--to=/Volumes/Archive/Notes &amp; Drafts</string>
	</array>
